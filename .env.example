# Snepr Production Environment Configuration Template
# Copy this file to .env and supply the respective credentials.

# 1. Database Connection (Supabase Session / Transaction Pooler)
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Supabase API Configuration
VITE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"

# 3. Transactional Email Service (Brevo / SendGrid / Amazon SES)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="[SMTP_LOGIN]"
SMTP_PASS="[SMTP_PASSWORD]"
SMTP_FROM_NAME="Snepr Support"
SMTP_FROM_EMAIL="support@snepr.in"

# 4. Mobile / Web App Configuration
VITE_API_BASE_URL="https://snepr.in"
